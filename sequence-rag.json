  "cards": [
    {
      "dot": "emerald",
      "title": "Query dismantling",
      "items": [
        "The 'Other Steve' persona intercepts the raw query and strips conversational padding.",
        "It outputs explicit `<query>` tags representing concrete Ruby tasks.",
        "These are fed into the Hybrid Vector DB for precise matching."
      ]
    },
    {
      "dot": "cyan",
      "title": "Architectural Grounding",
      "items": [
        "Before generating the final answer, the Agent pauses to inspect the target project.",
        "It queries the Codebase Memory MCP for the target's architecture and graph relationships.",
        "This prevents it from hallucinating file paths or generic README tutorials."
      ]
    },
    {
      "dot": "rose",
      "title": "Pragmatic Backlog Output",
      "items": [
        "The LLM synthesizes the semantic gem matches and the exact codebase graph schema.",
        "It generates executable User Stories anchored to specific files and methods.",
        "The response can be blindly executed by other downstream coding agents."
      ]
    }
  ]
